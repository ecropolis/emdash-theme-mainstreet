  "license": "MIT",
  "type": "module",
  "keywords": [
    "astro-template",
    "emdash",
    "emdash-theme",
    "service-business",
    "booking",
    "salon",
    "spa",
    "wellness"
  ],
  "emdash": {
    "label": "Mainstreet",
